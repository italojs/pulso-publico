DATABASE_URL=postgres://app:app@127.0.0.1:5435/legislativo_codex_dev
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
SENADO_BASE_URL=https://legis.senado.leg.br/dadosabertos
HTTP_TIMEOUT_MS=10000
HTTP_MAX_ATTEMPTS=3
LEGISLATIVE_HISTORY_START_YEAR=2019

# Dados eleitorais oficiais do TSE. Não exigem chave de API.
TSE_DATA_BASE_URL=https://cdn.tse.jus.br
ELECTORAL_MEDIA_DIRECTORY=.data/electoral-assets
ELECTION_YEAR=2026
# Em desenvolvimento local nenhuma UF é estimada pelo IP.
GEO_PROVIDER=none

# O aplicativo funciona sem IA. Preencha os dois campos para gerar título e descrição simples.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Web Push é opcional; alertas dentro do aplicativo não dependem destas chaves.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

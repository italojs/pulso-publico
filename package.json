{
  "name": "pulso-publico",
  "version": "0.1.0",
  "description": "Acompanhamento neutro da política brasileira com dados oficiais e linguagem acessível.",
  "license": "MIT",
  "author": "Italo José (https://github.com/italojs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italojs/pulso-publico.git"
  },
  "bugs": { "url": "https://github.com/italojs/pulso-publico/issues" },
  "homepage": "https://github.com/italojs/pulso-publico#readme",
  "keywords": ["civic-tech", "brasil", "dados-abertos", "camara", "senado", "tse"],
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22 <23"
  },
  "imports": {
    "#/ui/format": "./src/ui/format.ts",
    "#/ui/*": "./src/ui/*.tsx",
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "sync": "tsx scripts/sync.ts",
    "backfill:legislative": "tsx scripts/backfill-legislative.ts",
    "backfill:votes": "tsx scripts/backfill-camara-votes.ts",
    "collect:history": "tsx scripts/collect-history.ts",
    "collect:status": "tsx scripts/collect-status.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "sync:election": "tsx scripts/sync-election.ts",
    "candidates:link": "tsx scripts/manage-candidate-link.ts",
    "summaries": "tsx scripts/generate-summaries.ts",
    "practical-impact:prepare": "tsx scripts/prepare-practical-impact-batch.ts --limit=600",
    "practical-impact:append:5000": "tsx scripts/append-practical-impact-batch.ts --limit=5000",
    "practical-impact:verify": "tsx scripts/verify-practical-impact-batch.ts",
    "practical-impact:verify:5600": "tsx scripts/verify-practical-impact-batch.ts --expected=5600",
    "alerts:dispatch": "tsx scripts/dispatch-push.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.3.0",
    "unzipper": "0.12.5",
    "web-push": "^3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "0.10.11",
    "@types/web-push": "^3.6.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
